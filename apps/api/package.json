{
  "name": "@petxport/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup",
    "migrate": "tsx src/db/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "vapid": "tsx src/notify/vapid.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "seed": "tsx src/db/seed.ts",
    "addresses:tidy": "tsx src/db/tidy-addresses.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/static": "^10.1.11",
    "@fastify/websocket": "^11.3.7",
    "@node-rs/argon2": "^2.0.0",
    "@petxport/shared": "workspace:*",
    "@simplewebauthn/server": "^14.1.0",
    "dotenv": "^16.4.0",
    "drizzle-orm": "^0.45.0",
    "fastify": "^5.12.8",
    "nodemailer": "^10.6.0",
    "pg": "^8.23.1",
    "web-push": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.11.0",
    "@types/web-push": "^3.6.0",
    "@types/ws": "^8.5.0",
    "drizzle-kit": "^0.31.11",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.8.0",
    "vitest": "^5.1.0",
    "ws": "^8.23.0"
  }
}
