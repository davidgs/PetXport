# --- Server ---
PORT=3000
# Address to listen on. Keep 127.0.0.1 when a reverse proxy sits in front.
HOST=127.0.0.1
# Public URL of the app; used in email, SMS and push links.
APP_URL=http://localhost:5180
# Comma-separated email addresses of platform admins ("super-admins"). After signing up with
# one of these addresses, that person can create rescue organizations and invite the person
# who will run each one, at /admin.
PLATFORM_ADMIN_EMAILS=
# New rescues join by invitation from a platform admin. Set to true to also let anyone
# who signs up create an organization for themselves.
ALLOW_ORG_SIGNUP=false

# Which peers may set X-Forwarded-For (the visitor's address, used for rate limits).
# The default trusts only a reverse proxy on this same machine. Change it only if your
# proxy runs elsewhere, e.g. TRUST_PROXY=10.0.0.5
# TRUST_PROXY=loopback

# --- PostgreSQL ---
# The app connects as a restricted role that cannot bypass row-level security.
DATABASE_URL=postgres://petxport_app:change-me@localhost:5432/petxport_dev
# Owner connection, used only by `pnpm migrate`. It creates tables, policies and the app role.
MIGRATION_DATABASE_URL=postgres://owner@localhost:5432/petxport_dev
# Test databases. The name must end in _test; the test suite wipes it.
TEST_DATABASE_URL=postgres://petxport_app:change-me@localhost:5432/petxport_test
TEST_MIGRATION_DATABASE_URL=postgres://owner@localhost:5432/petxport_test

# --- Routing and geocoding ---
# With a key, OpenRouteService is used. Without one the public OSRM and Nominatim demo
# servers are used, which is fine for trying things out but not for production.
ORS_API_KEY=
# ROUTING_PROVIDER=ors | osrm
# OSRM_URL=https://router.project-osrm.org
# NOMINATIM_URL=https://nominatim.openstreetmap.org
# Nearby gas stations, rest areas, hotels and restaurants for choosing handoff places.
# One or more Overpass servers, comma-separated; each is tried in turn.
# OVERPASS_URL=https://overpass-api.de/api/interpreter,https://overpass.private.coffee/api/interpreter

# --- Email --- (leave SMTP_URL empty to print emails to the console)
SMTP_URL=
MAIL_FROM=PetXport <no-reply@example.org>
# In production the server refuses to start without SMTP_URL, because sign-in links would be
# written to the server log instead. Set this to true only if you really want that.
# ALLOW_EMAIL_TO_LOG=false
# Ceiling on invitation emails one organization can send per day.
# INVITES_DAILY_LIMIT_PER_ORG=500

# --- Web push --- (generate with `pnpm vapid`)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.org

# --- SMS (optional) ---
# Sent through Brevo's transactional SMS service; texts are paid for with SMS credits bought
# in the Brevo account. The API key is under SMTP & API > API keys (it starts with "xkeysib-"
# and is not the SMTP key used in SMTP_URL). The sender is what recipients see: a name of up
# to 11 letters and digits, or a number of up to 15 digits where the country requires one
# (the United States and Canada do).
BREVO_API_KEY=
BREVO_SMS_SENDER=
# Lets Brevo tell PetXport when someone replies STOP, so their profile is switched off too.
# Any long random string; give Brevo the same value when creating the webhook (see README).
BREVO_WEBHOOK_SECRET=
# Troubleshooting only: log every webhook call from Brevo in full (includes phone numbers).
# BREVO_WEBHOOK_DEBUG=true
# Ceiling on notification texts one organization can send per day.
# SMS_DAILY_LIMIT_PER_ORG=300
